# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Neon Auth (Managed Better Auth Service)
NEON_AUTH_BASE_URL="https://your-neon-auth-url.neon.tech"
NEON_AUTH_COOKIE_SECRET="..."

# Application
NEXT_PUBLIC_APP_NAME=WishHub
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Extension
NEXT_PUBLIC_EXTENSION_ID=

# Storage
STORAGE_BUCKET=

# Email (future)
RESEND_API_KEY=
EMAIL_FROM=

# Push Notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# Feature Flags
FEATURE_AI=false
FEATURE_PRICE_TRACKING=false
FEATURE_NOTIFICATIONS=false
FEATURE_PUBLIC_WISHLISTS=false
