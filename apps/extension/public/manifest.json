{
  "manifest_version": 3,
  "name": "WishHub",
  "version": "0.1.0",
  "description": "Universal Wishlist Platform",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
