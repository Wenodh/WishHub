generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  image         String?
  wishlists     Wishlist[]
  savedProducts SavedProduct[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CatalogProduct {
  id              String         @id @default(cuid())
  canonicalUrl    String         @unique
  name            String
  description     String?
  brand           String?
  storeName       String?
  price           Float?
  currency        String?
  images          CatalogProductImage[]
  rawMetadata     Json?
  metadataVersion Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  savedBy         SavedProduct[]

  @@index([canonicalUrl])
}

model CatalogProductImage {
  id               String         @id @default(cuid())
  catalogProductId String
  product          CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  url              String
  type             String?        @default("original")
  createdAt        DateTime       @default(now())

  @@index([catalogProductId])
}

model SavedProduct {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  notes            String?
  archived         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  wishlistItems    WishlistItem[]

  @@unique([userId, catalogProductId])
  @@index([userId])
  @@index([catalogProductId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     WishlistItem[]

  @@unique([userId, name])
  @@index([userId])
}

model WishlistItem {
  id             String       @id @default(cuid())
  wishlistId     String
  wishlist       Wishlist     @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  savedProductId String
  savedProduct   SavedProduct @relation(fields: [savedProductId], references: [id], onDelete: Cascade)
  addedAt        DateTime     @default(now())

  @@unique([wishlistId, savedProductId])
  @@index([wishlistId])
  @@index([savedProductId])
}
