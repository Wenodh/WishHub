generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  image         String?
  wishlists     Wishlist[]
  savedProducts SavedProduct[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CatalogProduct {
  id           String   @id @default(cuid())
  store        String
  externalId   String?
  canonicalUrl String   @unique
  title        String
  description  String?
  brand        String?
  images       Json     @default("[]")
  category     String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedBy SavedProduct[]

  @@index([canonicalUrl])
  @@index([store, externalId])
}

model SavedProduct {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  originalUrl      String
  addedAt          DateTime @default(now())
  archivedAt       DateTime?

  wishlistItems    WishlistItem[]

  @@unique([userId, catalogProductId])
  @@index([userId])
  @@index([catalogProductId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     WishlistItem[]

  @@unique([userId, name])
  @@index([userId])
}

model WishlistItem {
  wishlistId     String
  wishlist       Wishlist     @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  savedProductId String
  savedProduct   SavedProduct @relation(fields: [savedProductId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([wishlistId, savedProductId])
  @@index([wishlistId])
  @@index([savedProductId])
}
