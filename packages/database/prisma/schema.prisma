generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  image         String?
  wishlists     Wishlist[]
  savedProducts SavedProduct[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CatalogProduct {
  id           String   @id @default(cuid())
  store        String
  externalId   String?
  canonicalUrl String   @unique
  title        String
  description  String?
  brand        String?
  images       Json     @default("[]")
  category     String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedBy SavedProduct[]
  insights ProductInsight[]
  tags     ProductTag[]
  aiJobs   AIJob[]

  @@index([canonicalUrl])
  @@index([store, externalId])
}

model ProductInsight {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  summary          String?
  pros             Json           @default("[]")
  cons             Json           @default("[]")
  buyRecommendation String?
  confidenceScore  Float?
  reasoning        String?
  provider         String
  model            String
  promptVersion    String
  contentFingerprint String
  metadata         Json           @default("{}")
  generatedAt      DateTime       @default(now())
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([catalogProductId, promptVersion])
  @@index([catalogProductId])
}

model ProductTag {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  name             String

  @@unique([catalogProductId, name])
  @@index([catalogProductId])
}

model AIJob {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  status           String         @default("PENDING")
  priority         Int            @default(0)
  attempts         Int            @default(0)
  maxAttempts      Int            @default(3)
  lockedAt         DateTime?
  lockedBy         String?
  retryAfter       DateTime?
  processingTime   Int?
  errorLog         String?
  tokenUsage       Json           @default("{}")
  estimatedCost    Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([catalogProductId])
}

model SavedProduct {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  originalUrl      String
  addedAt          DateTime @default(now())
  archivedAt       DateTime?

  wishlistItems    WishlistItem[]

  @@unique([userId, catalogProductId])
  @@index([userId])
  @@index([catalogProductId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     WishlistItem[]

  @@unique([userId, name])
  @@index([userId])
}

model WishlistItem {
  wishlistId     String
  wishlist       Wishlist     @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  savedProductId String
  savedProduct   SavedProduct @relation(fields: [savedProductId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([wishlistId, savedProductId])
  @@index([wishlistId])
  @@index([savedProductId])
}
