{
  "name": "wishhub",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:studio": "pnpm --filter @wishhub/database exec prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint-plugin-only-warn": "^1.2.1",
    "prettier": "^3.3.3",
    "tsx": "^4.22.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  }
}
